---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { PROJECTS, SITE } from "../lib/site";

const title = "LSS-boenden på totalentreprenad, Oskarshamn och Vallentuna";
const description =
  "Vi bygger LSS-boenden på totalentreprenad. Pågående projekt i Oskarshamn och Vallentuna, kapacitet för cirka fem boenden per år. Egen projektering och milstolpsstyrd betalplan.";

const lssProjects = PROJECTS.filter((p) => p.slug.startsWith("lss-"));

const leveranser = [
  {
    title: "Totalentreprenad ABT 06",
    desc: "Ett avtal, en ansvarig part. Vi tar projektet från första skiss till inflyttningsklart boende och äger samordningen mellan mark, stomme och installationer.",
  },
  {
    title: "Egen mark- och byggprojektering",
    desc: "Gränssnitten löses innan spaden går i marken. Det ger färre överraskningar, lägre ÄTA-volym och en tidplan som håller, även på tomter med komplexa markförhållanden.",
  },
  {
    title: "Milstolpsstyrd betalplan",
    desc: "Faktureringen följer en fast lyftplan kopplad till verifierade milstolpar. Beställaren ser exakt vad som är utfört innan varje betalning.",
  },
  {
    title: "Full dokumentation och KMA",
    desc: "KMA-plan per projekt, egenkontroller, dagbok och överlämningsdokumentation. Allt paketerat för förvaltning och tillsyn från dag ett.",
  },
];

const forVem = [
  {
    title: "Privata omsorgsaktörer",
    desc: "Stabila och finansiellt starka beställare som driver LSS- och SoL-verksamhet och behöver en byggpartner som levererar färdiga boenden på utsatt tid.",
  },
  {
    title: "Kommuner",
    desc: "Vi är etablerad leverantör till kommunal sektor och van vid LOU:s krav på referenser, dokumentation och finansiell stabilitet.",
  },
  {
    title: "Fastighetsutvecklare",
    desc: "Utvecklare som bygger samhällsfastigheter för långsiktig förvaltning eller försäljning till institutionella ägare.",
  },
];
// FAQ formulerad svar-först: varje svar ska kunna citeras fristående av AI-assistenter.
// Endast verifierade fakta från sajten, inga uppskattade tider eller priser.
const faqs = [
  {
    q: "Vilken byggentreprenör i Stockholm bygger LSS-boenden?",
    a: "RM Entreprenad & Fasad AB är en Stockholmsbaserad byggentreprenör som bygger LSS- och SoL-boenden på totalentreprenad (ABT 06). Bolaget har pågående LSS-projekt i Oskarshamn (Lokremmen 1) och Vallentuna (Ubby 1:43) och kapacitet för cirka fem boenden per år.",
  },
  {
    q: "Bygger ni LSS-boenden utanför Stockholm?",
    a: "Ja. RM har sin bas i Stockholm och arbetar i Stockholm och Mälardalen, men tar LSS-projekt även utanför regionen. Ett av de pågående LSS-boendena byggs i Oskarshamn.",
  },
  {
    q: "Vad ingår i en totalentreprenad för ett LSS-boende?",
    a: "Hela kedjan från projektering till inflyttningsklart boende: egen mark- och byggprojektering, markarbeten och grundläggning, prefabricerad stomme, installationer genom upphandlade underentreprenörer, egenkontroller, KMA-plan och komplett överlämningsdokumentation. Beställaren har ett avtal och en ansvarig projektledare.",
  },
  {
    q: "Vilken projektstorlek tar RM Entreprenad & Fasad?",
    a: "RM åtar sig totalentreprenader från cirka 20 Mkr och uppåt, gärna projekt med komplexa markarbeten där egen mark- och byggprojektering gör störst skillnad. Största genomförda projekt är grundläggningen av Kvarteret Persikan åt Stockholmshem, 75 Mkr.",
  },
  {
    q: "Använder ni prefabricerad stomme för LSS-boenden?",
    a: "Ja. RM bygger med svensktillverkad prefabricerad stomme i nära samarbete med en husfabrik: utfackningsväggar med isolering och fönster monterade, eller kompletta modulvolymer. Elementen är CE-märkta med prestandadeklaration och projekteras för byggnader som certifieras enligt Miljöbyggnad Brons, Silver eller Guld.",
  },
  {
    q: "Hur skyddas beställaren ekonomiskt under byggtiden?",
    a: "Genom en milstolpsstyrd betalplan där fakturering kopplas till verifierade milstolpar, och genom principen att ingen underentreprenör får betalt innan beställaren godkänt leveransen enligt avtal. RM Entreprenad & Fasad har 96 procents soliditet.",
  },
  {
    q: "Vilka beställare bygger RM LSS-boenden åt?",
    a: "Privata omsorgsaktörer som driver LSS- och SoL-verksamhet, kommuner som upphandlar enligt LOU, och fastighetsutvecklare som bygger samhällsfastigheter för långsiktig förvaltning.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Nyproduktion av LSS-boenden på totalentreprenad",
    name: "LSS-boenden på totalentreprenad",
    provider: { "@id": `${SITE.url}/#organization` },
    areaServed: ["Stockholm", "Stockholms län", "Mälardalen", "Sverige"],
    audience: { "@type": "Audience", audienceType: "Omsorgsaktörer, kommuner och fastighetsutvecklare" },
    url: `${SITE.url}/lss-boenden/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Hem", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "LSS-boenden", item: `${SITE.url}/lss-boenden/` },
    ],
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <article>
    <section class="pt-24 lg:pt-32 pb-12 lg:pb-20">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-brand-red)] font-semibold mb-6">LSS-boenden</p>
        <h1 class="text-[length:var(--text-display)] font-semibold leading-[1] tracking-tight max-w-4xl mb-8">
          Vi bygger LSS-boenden på totalentreprenad.
        </h1>
        <p class="text-lg lg:text-xl text-[color:var(--color-ink-60)] leading-relaxed max-w-3xl">
          Just nu bygger vi LSS-boenden i Oskarshamn och Vallentuna, och vi planerar för cirka fem boenden per år.
          Våra beställare är stabila och finansiellt starka aktörer: stora privata företag och kommuner.
          Vi åtar oss totalentreprenader från cirka 20 Mkr och uppåt, gärna projekt med komplexa markarbeten där vår egen mark- och byggprojektering gör störst skillnad.
        </p>
      </div>
    </section>

    <section class="py-12 lg:py-20 bg-[color:var(--color-paper-2)]">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <h2 class="text-[length:var(--text-h2)] font-semibold tracking-tight mb-10">Vad vi levererar</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {leveranser.map((item) => (
            <div class="p-8 bg-white rounded-2xl">
              <h3 class="text-xl font-semibold mb-3">{item.title}</h3>
              <p class="text-sm text-[color:var(--color-ink-60)] leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
        <p class="text-base text-[color:var(--color-ink-60)] leading-relaxed max-w-3xl mt-10">
          Vår kassaflödesprincip skyddar beställaren:
          <strong class="text-[color:var(--color-ink)]">ingen underentreprenör får betalt innan ni godkänt leveransen enligt avtal.</strong>
          Det ger ordning i varje led och en leverantörskedja som presterar hela vägen till slutbesiktning.
        </p>
      </div>
    </section>

    <section class="py-12 lg:py-20">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <h2 class="text-[length:var(--text-h2)] font-semibold tracking-tight mb-10">Pågående LSS-projekt</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {lssProjects.map((p) => (
            <a href={`/projekt/${p.slug}`} class="group block p-8 bg-[color:var(--color-paper-2)] rounded-2xl hover:bg-[color:var(--color-ink)] hover:text-white transition-all duration-500">
              <p class="text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-brand-red)] font-semibold mb-3">{p.period}</p>
              <h3 class="text-xl font-semibold mb-3 group-hover:text-[color:var(--color-brand-red)] transition-colors">{p.title}</h3>
              <p class="text-sm text-[color:var(--color-ink-60)] group-hover:text-white/60 leading-relaxed">{p.type}{p.volume ? ` · ${p.volume}` : ""}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-12 lg:py-20 bg-[color:var(--color-paper-2)]">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <h2 class="text-[length:var(--text-h2)] font-semibold tracking-tight mb-10">För vem</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {forVem.map((item) => (
            <div class="p-8 bg-white rounded-2xl">
              <h3 class="text-xl font-semibold mb-3">{item.title}</h3>
              <p class="text-sm text-[color:var(--color-ink-60)] leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
        <p class="text-base text-[color:var(--color-ink-60)] leading-relaxed max-w-3xl mt-10">
          Ett LSS-boende är en fastighet där funktion, tillgänglighet och driftsäkerhet avgör verksamhetens vardag i decennier.
          Därför bygger vi med samma styrsystem som i våra mest komplexa entreprenader.
          <a href="/systemet" class="text-[color:var(--color-brand-red)] hover:underline font-medium">Läs om Systemet →</a>
        </p>
      </div>
    </section>

    <section class="py-12 lg:py-20">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <h2 class="text-[length:var(--text-h2)] font-semibold tracking-tight mb-10">Vanliga frågor om LSS-boenden</h2>
        <div class="space-y-4 max-w-4xl">
          {faqs.map((f) => (
            <details class="group bg-[color:var(--color-paper-2)] rounded-2xl">
              <summary class="cursor-pointer p-6 lg:p-8 flex items-start justify-between gap-6 list-none">
                <h3 class="text-lg lg:text-xl font-semibold tracking-tight">{f.q}</h3>
                <span class="text-[color:var(--color-brand-red)] text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="px-6 lg:px-8 pb-6 lg:pb-8 -mt-2 text-[color:var(--color-ink-60)] leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTA />
  </article>
</BaseLayout>
