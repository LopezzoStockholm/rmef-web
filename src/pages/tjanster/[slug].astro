---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import { SERVICES, PROJECTS, SITE } from "../../lib/site";

export function getStaticPaths() {
  return Object.values(SERVICES)
    .filter((s) => !s.customPage)
    .map((s) => ({
      params: { slug: s.slug },
      props: { service: s },
    }));
}

const { service } = Astro.props;

// Explicita referenser för discipliner som inte motsvaras av en projektkategori.
const relatedBySlug: Record<string, string[]> = {
  projektering: ["lss-ubby-vallentuna", "norrtalje-sjukhus", "lss-lokremmen-oskarshamn"],
  fasad: ["vindarnas-tempel", "kaptensstugan", "rocmore-signalisten"],
};
const relatedProjects = relatedBySlug[service.slug]
  ? relatedBySlug[service.slug].map((s) => PROJECTS.find((p) => p.slug === s)).filter((p): p is NonNullable<typeof p> => !!p)
  : PROJECTS.filter((p) =>
      p.category.toLowerCase().includes(service.title.split(" ")[0].toLowerCase())
    ).slice(0, 3);

// SEO-optimerade titlar/descriptions per service-slug. Faller tillbaka till service.title.
const seoOverrides: Record<string, { title?: string; desc?: string }> = {
  fasad: {
    title: "Fasadrenovering Stockholm, puts, isolering, BRF",
    desc: "Fasadrenovering i Stockholm för bostadsrättsföreningar och fastighetsägare. Omputsning, tilläggsisolering, antikvariska restaureringar.",
  },
  bygg: {
    title: "Totalentreprenad Stockholm, ABT 06, AB 04",
    desc: "Totalentreprenader och utförandeentreprenader i Stockholm. Kontorsanpassning, nyproduktion, K-märkt restaurering. Egen projektledning.",
  },
  projektering: {
    title: "Projektering inhouse, mark- och byggprojektering Stockholm",
    desc: "Egen mark- och byggprojektering inhouse. Gränssnitten lösta innan utförandet startar. Reducerad ÄTA-volym, kostnadseffektivare totalentreprenad.",
  },
  "mark-och-anlaggning": {
    title: "Markarbeten & grundläggning Stockholm, schakt, spontning",
    desc: "Markentreprenör i Stockholm. Schakt, grundläggning, spontning, skyddsrum, ledningsarbeten. Referens: 75 Mkr Stockholmshem.",
  },
};
const seo = seoOverrides[service.slug] ?? {};
const pageTitle = seo.title ?? service.title;
const pageDesc = seo.desc ?? service.long.slice(0, 155);

// FAQ per tjänst. Renderas som sektion och som FAQPage-schema (formatet AI-sök oftast citerar).
const faqBySlug: Record<string, { q: string; a: string }[]> = {
  bygg: [
    {
      q: "Vad kostar en totalentreprenad?",
      a: "Priset sätts av omfattning, markförhållanden och verksamhetens krav, inte av en kvadratmeterprislista. Vi åtar oss totalentreprenader från cirka 20 Mkr och uppåt och lämnar besked inom 48 timmar efter genomgång av underlaget. Faktureringen följer en milstolpsstyrd betalplan så att beställaren ser vad som är utfört före varje betalning.",
    },
    {
      q: "Vad är skillnaden mellan totalentreprenad ABT 06 och utförandeentreprenad AB 04?",
      a: "I en totalentreprenad enligt ABT 06 ansvarar entreprenören för både projektering och utförande, beställaren har en avtalspart med helhetsansvar. I en utförandeentreprenad enligt AB 04 tar beställaren fram färdiga handlingar och entreprenören ansvarar för utförandet. Vi driver båda formerna och hjälper gärna till att välja rätt form för projektet.",
    },
    {
      q: "Hur stora projekt åtar ni er?",
      a: "Totalentreprenader från cirka 20 Mkr och uppåt, gärna projekt med komplexa markarbeten där vår egen mark- och byggprojektering gör störst skillnad. Just nu bygger vi bland annat LSS-boenden i Oskarshamn och Vallentuna.",
    },
    {
      q: "Kan ni ta över ett pågående projekt?",
      a: "Ja. Vi har tagit över entreprenader mitt i pågående projekt efter byte av entreprenör och hållit både kvalitet och budget, utan att störa hyresgäster eller pågående verksamhet.",
    },
  ],
  "mark-och-anlaggning": [
    {
      q: "Vad kostar markarbeten?",
      a: "Kostnaden styrs av markförhållandena: berg som ska sprängas, jordarnas bärighet, schaktvolym, grundvatten och hur trång arbetsplatsen är. Därför prissätter vi efter platsbesök och genomgång av handlingarna, med besked inom 48 timmar.",
    },
    {
      q: "När krävs spontning?",
      a: "Spontning krävs när en schakt går djupt intill befintliga byggnader, gator eller ledningar, eller när jorden är för lös för att stå med slänt. Sponten håller tillbaka jorden och skyddar omgivande konstruktioner medan grundläggningen utförs.",
    },
    {
      q: "Utför ni betongarbeten?",
      a: "Ja. Platsgjutna bottenplattor, källarväggar och skyddsrum är en central del av vår markentreprenad, med egen formsättning, armering och gjutning. Se vår sida om betongarbeten för referenser och arbetssätt.",
    },
  ],
  projektering: [
    { q: "Vad innebär det att entreprenören har egen projektering?", a: "Att mark- och byggprojekteringen görs av samma organisation som bygger. Gränssnitten mellan mark, stomme och installationer löses innan produktionen startar, i stället för att upptäckas på byggplatsen. Det ger färre överraskningar, lägre ÄTA-volym och en kostnadsram som håller redan i anbudsskedet." },
    { q: "Kan ni granska handlingar vi redan har?", a: "Ja. Vi granskar befintliga handlingar före anbud och pekar ut oklara gränssnitt och risker för ÄTA. Underlaget kan sedan användas för både totalentreprenad och utförandeentreprenad." },
    { q: "Hur minskar projektering ÄTA-kostnaderna?", a: "ÄTA-arbeten uppstår oftast ur ofullständiga handlingar och olösta gränssnitt mellan discipliner. Genomarbetade handlingar och en KMA-plan kopplad till projekteringen gör att färre frågor måste lösas i efterhand, när varje ändring är som dyrast." },
    { q: "I vilka projekt har ni projekterat själva?", a: "Bland annat LSS-boendet Ubby 1:43 i Vallentuna, där gränssnitten mellan mark, stomme och installationer löstes i projekteringen innan produktionen startade, och sprinklercentralen vid Norrtälje sjukhus, som vi både projekterade och utförde." },
  ],
  fasad: [
    { q: "Vad kostar en fasadrenovering?", a: "Riktpriset i Stockholmsregionen är 1 500 till 3 500 kr per kvadratmeter fasadyta, beroende på om fasaden lagas lokalt, putsas om helt eller tilläggsisoleras. Exakt pris lämnas efter platsbesök och statusbedömning." },
    { q: "Vad ingår i en fasadrenovering?", a: "Besiktning och statusbedömning, ställning och väderskydd, lagning eller omputsning, målning och vid behov tilläggsisolering. Balkong- och betongåtgärder kan samordnas i samma entreprenad, vilket sparar ställnings- och etableringskostnader." },
    { q: "Arbetar ni med kulturhistoriska och K-märkta fasader?", a: "Ja. Vi har restaurerat K-märkta byggnader åt Lidingö Stad, bland annat Vindarnas tempel och Kaptensstugan, med antikvarisk kontroll genom hela processen och återanvändning av originalmaterial där det varit möjligt." },
    { q: "Var utför ni fasadrenovering?", a: "I Stockholm och Mälardalen, bland annat Lidingö, Solna, Sundbyberg, Nacka, Täby, Danderyd och Sollentuna. Se våra lokala sidor för referenser per ort." },
  ],
};
// Fördjupning för discipliner som annars blir tunna sidor.
const detailsBySlug: Record<string, { h: string; p: string }[]> = {
  projektering: [
    { h: "Därför bygger vi med egen projektering", p: "De dyraste problemen i en entreprenad uppstår i gränssnitten: där marken möter stommen, där stommen möter installationerna och där en konsults handlingar möter en annan entreprenörs verklighet. När projekteringen görs av samma organisation som bygger, ägs gränssnitten av en part från start. Därför kan vi lämna en kostnadsram som håller och en tidplan som går att lita på." },
    { h: "Så går det till", p: "Vi går igenom ert underlag och platsens förutsättningar, granskar befintliga handlingar eller tar fram nya inom mark och bygg, kopplar KMA-planen till projekteringen och löser gränssnitten innan produktionen startar. Resultatet blir ett genomarbetat underlag för anbud och produktion, oavsett om projektet drivs som totalentreprenad enligt ABT 06 eller utförandeentreprenad enligt AB 04." },
  ],
  fasad: [
    { h: "Statusbedömning först", p: "En fasadrenovering börjar med en statusbedömning av putsens, betongens och fogarnas skick. Den visar om fasaden kan lagas lokalt eller behöver putsas om, och om det är rätt tillfälle att tilläggsisolera. Styrelsen får ett underlag som går att fatta beslut och upphandla på." },
    { h: "Samordnat med balkong och betong", p: "Fasad, balkonger och betong har ofta samma ålder och samma skador. Genom att samordna åtgärderna i en entreprenad delas ställning, etablering och projektledning, vilket sänker kostnaden per åtgärd och kortar tiden med ställning för de boende." },
  ],
};
const details = detailsBySlug[service.slug];
const faq = faqBySlug[service.slug];

const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      serviceType: service.title,
      provider: { "@id": `${SITE.url}/#organization` },
      areaServed: "Stockholm",
      description: service.long,
      url: `${SITE.url}/tjanster/${service.slug}`,
    },
    ...(faq
      ? [
          {
            "@type": "FAQPage",
            mainEntity: faq.map((f) => ({
              "@type": "Question",
              name: f.q,
              acceptedAnswer: { "@type": "Answer", text: f.a },
            })),
          },
        ]
      : []),
  ],
};
import RelatedServices from "../../components/RelatedServices.astro";
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  schema={serviceSchema}
>
  <article>
    <section class="pt-24 lg:pt-32 pb-12 lg:pb-20">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <nav class="text-xs text-[color:var(--color-ink-40)] mb-8" aria-label="Brödsmulor">
          <a href="/" class="hover:text-[color:var(--color-brand-red)]">Hem</a>
          <span class="mx-2">/</span>
          <a href="/tjanster" class="hover:text-[color:var(--color-brand-red)]">Tjänster</a>
          <span class="mx-2">/</span>
          <span>{service.title}</span>
        </nav>

        {service.fromPrice && (
          <div class="inline-flex items-center gap-2 bg-[color:var(--color-brand-red)]/10 border border-[color:var(--color-brand-red)]/20 rounded-full px-4 py-1.5 text-xs font-semibold text-[color:var(--color-brand-red)] mb-6 tracking-wide">
            <span>{service.fromPrice}</span>
          </div>
        )}

        <h1 class="text-[length:var(--text-display)] font-semibold leading-[1] tracking-tight max-w-4xl mb-8">
          {service.title}
        </h1>
        <p class="text-lg lg:text-xl text-[color:var(--color-ink-60)] leading-relaxed max-w-3xl">
          {service.long}
        </p>
      </div>
    </section>

    <section class="py-12 lg:py-20 bg-[color:var(--color-paper-2)]">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <h2 class="text-[length:var(--text-h2)] font-semibold tracking-tight mb-10">Det här gör vi</h2>
        <ul class="grid md:grid-cols-2 gap-4 max-w-4xl">
          {
            service.bullets.map((b) => (
              <li class="flex items-start gap-3 text-lg">
                <svg width="22" height="22" viewBox="0 0 20 20" fill="none" class="mt-1 flex-shrink-0 text-[color:var(--color-brand-red)]" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.25"/>
                  <path d="M6 10.5l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="leading-relaxed">{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {details && (
      <section class="py-12 lg:py-20">
        <div class="mx-auto max-w-7xl px-6 lg:px-10 grid lg:grid-cols-2 gap-12">
          {details.map((d) => (
            <div>
              <h2 class="text-[length:var(--text-h2)] font-semibold tracking-tight mb-6">{d.h}</h2>
              <p class="text-lg text-[color:var(--color-ink-60)] leading-relaxed">{d.p}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {faq && (
      <section class="py-12 lg:py-20">
        <div class="mx-auto max-w-7xl px-6 lg:px-10">
          <h2 class="text-[length:var(--text-h2)] font-semibold tracking-tight mb-10">Vanliga frågor</h2>
          <div class="grid gap-6 max-w-4xl">
            {faq.map((f) => (
              <div class="p-8 bg-[color:var(--color-paper-2)] rounded-2xl">
                <h3 class="text-lg font-semibold mb-3">{f.q}</h3>
                <p class="text-[color:var(--color-ink-60)] leading-relaxed">{f.a}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {relatedProjects.length > 0 && (
      <section class="py-20 lg:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-10">
          <h2 class="text-[length:var(--text-h2)] font-semibold tracking-tight mb-10">Relaterade projekt</h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
              relatedProjects.map((p) => (
                <a href={`/projekt/${p.slug}`} class="group block p-8 bg-[color:var(--color-paper-2)] rounded-2xl hover:bg-[color:var(--color-ink)] hover:text-white transition-all duration-500">
                  <p class="text-xs uppercase tracking-wider text-[color:var(--color-ink-40)] group-hover:text-white/40 mb-4">
                    {p.client}
                  </p>
                  <h3 class="text-xl font-semibold mb-3 group-hover:text-[color:var(--color-brand-red)] transition-colors">
                    {p.title}
                  </h3>
                  <p class="text-sm text-[color:var(--color-ink-60)] group-hover:text-white/60 leading-relaxed line-clamp-3 mb-4">
                    {p.summary}
                  </p>
                  {p.volume && (
                    <p class="text-sm font-semibold text-[color:var(--color-brand-red)]">{p.volume}</p>
                  )}
                </a>
              ))
            }
          </div>
        </div>
      </section>
    )}

    <RelatedServices />

    <CTA />
  </article>
</BaseLayout>
